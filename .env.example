# Copiez ce fichier en .env puis adaptez les valeurs. Ne versionnez JAMAIS .env.
# Il est lu par Docker Compose, par le backend lancé depuis backend/, et peut servir
# à « docker run --env-file .env ». Ce modèle ne contient aucun secret réel.

# ------------------------------------------------------------------
# Base de données
# ------------------------------------------------------------------
# Développement local (Docker Compose) :
DB_NAME=nidaldeco
DB_USERNAME=nidaldeco
DB_PASSWORD=remplacez-par-un-mot-de-passe-long
DB_PORT=5432
# Production (profil prod) : URL JDBC complète, obligatoire. Exemple Neon :
# DB_URL=jdbc:postgresql://HOTE.neon.tech/BASE?sslmode=require
# DB_POOL_SIZE=5

# ------------------------------------------------------------------
# Serveur
# ------------------------------------------------------------------
# local | prod. Le profil « demo » (contenus d'exemple) ne s'ajoute qu'explicitement.
# SPRING_PROFILES_ACTIVE=prod
# Port d'écoute. Sans SERVER_PORT, la variable PORT de l'hébergeur est utilisée, sinon 8080.
SERVER_PORT=8080
# URL publique du site, sans slash final (sitemap, robots.txt, Open Graph). Obligatoire en prod.
APP_PUBLIC_BASE_URL=http://localhost:5180
# Origines CORS autorisées. Vide = même origine uniquement (cas normal).
APP_CORS_ALLOWED_ORIGINS=
# Derrière un proxy HTTPS : native (valeur par défaut du profil prod).
# SERVER_FORWARD_HEADERS_STRATEGY=native
# Dossier du build React servi par Spring Boot. Vide en développement (Vite sert l'interface).
# Dans l'image Docker, il vaut déjà /app/frontend-dist : laissez cette ligne commentée,
# une valeur vide passée par « --env-file » désactiverait l'interface web.
# FRONTEND_DIST_DIR=

# ------------------------------------------------------------------
# Session administrateur
# ------------------------------------------------------------------
SESSION_TIMEOUT=30m
# true dès que le site est servi en HTTPS (valeur par défaut du profil prod).
SESSION_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW=15m

# ------------------------------------------------------------------
# Images téléversées
# ------------------------------------------------------------------
# filesystem : disque local (développement, ou serveur avec disque persistant).
# s3         : stockage objet compatible S3, par exemple Supabase Storage (défaut du profil prod).
APP_MEDIA_STORAGE=filesystem
MEDIA_MAX_FILE_SIZE=8MB
MEDIA_MAX_REQUEST_SIZE=10MB
# Mode filesystem : dossier persistant, hors du code source. Chemin relatif au dossier backend/.
MEDIA_STORAGE_DIR=../data/media

# Mode s3 : les six variables sont obligatoires, sinon l'application refuse de démarrer.
# Ne confondez pas les deux adresses :
#   S3_ENDPOINT        = API S3, utilisée par le serveur pour envoyer et supprimer les fichiers ;
#   S3_PUBLIC_BASE_URL = adresse où les navigateurs lisent les images.
#
# Endpoint de l'API S3. Supabase : https://REF_DU_PROJET.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=
# Région indiquée par le fournisseur. Supabase : région du projet, par exemple eu-central-1.
S3_REGION=
# Bucket public, réservé aux images du site.
S3_BUCKET=
# Clés S3. Chez Supabase elles donnent accès à TOUS les buckets du projet : serveur uniquement.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Adresse publique du bucket, sans slash final.
# Supabase : https://REF_DU_PROJET.supabase.co/storage/v1/object/public/NOM_DU_BUCKET
# Les images sont lues à S3_PUBLIC_BASE_URL/media/NOM-DU-FICHIER.
S3_PUBLIC_BASE_URL=

# ------------------------------------------------------------------
# Création du premier administrateur (variables TEMPORAIRES)
# ------------------------------------------------------------------
# À définir uniquement le temps de la commande, puis à supprimer. Voir le README.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
