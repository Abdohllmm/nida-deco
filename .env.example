# Copiez ce fichier en .env puis adaptez les valeurs. Ne versionnez jamais .env.
# Il est lu par Docker Compose et par le backend (lancé depuis le dossier backend/).

# --- Base de données ---
DB_NAME=nidaldeco
DB_USERNAME=nidaldeco
DB_PASSWORD=remplacez-par-un-mot-de-passe-long
DB_PORT=5432
# En production, préférez une URL complète :
# DB_URL=jdbc:postgresql://hote:5432/nidaldeco

# --- Serveur ---
SERVER_PORT=8080
# URL publique du site, sans slash final (sitemap, Open Graph).
APP_PUBLIC_BASE_URL=http://localhost:5180
# Origines autorisées en CORS, séparées par des virgules. Vide = même origine uniquement.
APP_CORS_ALLOWED_ORIGINS=
# Derrière un reverse proxy HTTPS : native (valeur par défaut du profil prod).
# SERVER_FORWARD_HEADERS_STRATEGY=native

# --- Session administrateur ---
SESSION_TIMEOUT=30m
# true dès que le site est servi en HTTPS (valeur par défaut du profil prod).
SESSION_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW=15m

# --- Images ---
# Dossier persistant, hors du code source. Chemin relatif au dossier backend/.
MEDIA_STORAGE_DIR=../data/media
MEDIA_MAX_FILE_SIZE=8MB
MEDIA_MAX_REQUEST_SIZE=10MB

# --- Interface web servie par le backend (production) ---
# Chemin du build React. Vide en développement (Vite sert l'interface).
FRONTEND_DIST_DIR=

# --- Création du premier administrateur (variables TEMPORAIRES) ---
# À définir uniquement le temps de la commande, puis à supprimer. Voir le README.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
