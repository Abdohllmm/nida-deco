# Modèle : copier en « .env » dans ce dossier, puis renseigner. Ne jamais versionner « .env ».
# Les valeurs actuelles se trouvent dans votre fichier local .env.deploy (mêmes noms).

# Adresse publique du site, sans https:// ni slash : un nom de domaine pointant vers le serveur
# (ex. nidaldeco.ma) ou, à défaut, l'adresse IP publique du serveur (ex. 203.0.113.10).
SITE_ADDRESS=

# Base de données Neon (projet nidal-deco-demo) : URL JDBC complète avec ?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Images : Supabase Storage (API compatible S3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Facultatif (valeurs par défaut entre parenthèses)
# SESSION_TIMEOUT=30m
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW=15m
# MEDIA_MAX_FILE_SIZE=8MB
# DB_POOL_SIZE=5
